# ─────────────────────────────────────────────────────────────
# Kitabash environment. Copy this file to `.env` and fill in.
# `.env` is git-ignored — NEVER commit real keys or passwords.
# Everything is optional: with nothing set, Kitabash runs on a
# local SQLite file with local file storage and the offline tutor.
# ─────────────────────────────────────────────────────────────

PORT=3000
# Long random string used to sign sessions. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
# Local data (SQLite file + uploads when not using Supabase)
DATA_DIR=./data

# ── Supabase: database ──────────────────────────────────────
# Supabase dashboard → Connect → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password. If the password contains
# special characters (@ : / # ? % space), URL-encode them (e.g. # → %23).
# Keep ?sslmode=require on the end.
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Optional: number of pooled connections (Supabase free tier: keep it small)
DATABASE_POOL_SIZE=5
# Optional: path to a CA certificate when using sslmode=verify-full
DATABASE_CA_CERT=

# ── Supabase: file storage (optional) ───────────────────────
# Supabase dashboard → Project Settings → API. When both are set, uploaded
# knowledge files and media go to a PRIVATE bucket instead of local disk.
# The service-role key is a server secret — never put it in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kitabash
# Force a driver: local | supabase (default: supabase when the two values above are set)
STORAGE_DRIVER=

# ── AI provider (optional) ──────────────────────────────────
# mock (default, offline rule-based tutor) | anthropic | openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
AI_RATE_LIMIT_PER_MIN=20
AI_MAX_OUTPUT_TOKENS=1500
AI_LOG_RETENTION_DAYS=90

# ── Other integrations (status shown in Admin → Platform → Integrations)
SPEECH_TO_TEXT_API_KEY=
OCR_API_KEY=
SMTP_URL=
